// PROJECT MEDOS — Medical Learning Operating System
// Core schema: curriculum graph + knowledge state + adaptive learning

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ───────────────────────── STUDENT ─────────────────────────

model StudentProfile {
  id             String   @id @default(cuid())
  name           String   @default("Future Dr.")
  year           Int      @default(1) // 1..4 = MBBS years, 5 = intern, 6 = dedicated prep
  semester       Int      @default(1)
  collegeName    String   @default("")
  collegeType    String   @default("government")
  gradYear       Int      @default(2030)
  internshipDone Boolean  @default(false)
  pastScore      String   @default("")
  prepStage      String   @default("exploring") // exploring|foundation|regular|serious|dedicated|revision
  dailyHours     Float    @default(2)
  weekdayHours   Float    @default(2)
  weekendHours   Float    @default(4)
  learningStyles Json     @default("[]") // visual,text,questions,cases,flashcards,audio,mixed
  resources      Json     @default("[]") // Marrow,PW,PrepLadder,DAMS,Cerebellum,other
  examMode       Boolean  @default(false) // college-exam priority mode
  examLabel      String   @default("")
  examDate       DateTime?
  onboarded      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  knowledgeStates KnowledgeState[]
  attempts        QuestionAttempt[]
  reviews         FlashcardReview[]
  revisionItems   RevisionItem[]
  sessions        StudySession[]
  errorPatterns   ErrorPattern[]
  caseRuns        CaseRun[]
  resourceLogs    ResourceLog[]
  savedPapers     SavedPaper[]
  adaptiveSessions AdaptiveSession[]
  savedQuestions  SavedQuestion[]
  questionReports QuestionReport[]
  mistakeRecords  MistakeRecord[]
  revisionSessions RevisionSession[]
}

// ───────────────────────── CURRICULUM GRAPH ─────────────────────────

model Subject {
  id          String @id // slug e.g. "anatomy"
  code        String @unique // ANAT, PHYS, PATHO...
  name        String
  year        Int // 1..4 (clinical subjects mapped to year they start)
  color       String @default("#22d3ee")
  neetWeight  Int    @default(5) // approximate % weight in NEET-PG
  blurb       String @default("")
  topics      Topic[]
  questions   Question[]
  flashcards  Flashcard[]

  @@index([code])
}

model Topic {
  id          String  @id
  subjectId   String
  subject     Subject @relation(fields: [subjectId], references: [id])
  name        String
  system      String? // cardiovascular, renal...
  importance  Int     @default(3) // 1..5 NEET-PG yield
  description String  @default("")
  concepts    Concept[]
}

model Concept {
  id          String  @id
  topicId     String
  topic       Topic   @relation(fields: [topicId], references: [id])
  name        String
  kind        String  @default("concept") // concept|disease|drug|investigation|physiology|anatomy|pathology|pharmacology|microbiology|clinical_skill
  summary     String  @default("") // one-line idea
  whyMatters  String  @default("") // "Why am I learning this" narrative
  detail      Json?   // structured sections for explorer: [{h, body[], table?}]
  // ── Global learning engine (additive, Task 19-h) ──
  lesson      Json?   // serialized ConceptLesson (full structured lesson)
  evidenceLevel String? // established|widely-taught|emerging|varies-by-guideline
  lastReviewed  String? // ISO date stamp of content review, e.g. '2026-10-05'
  examWeight    Int?    // 1..5 exam yield from the lesson quality system
  mnemonic    String  @default("")
  difficulty  Int     @default(2) // 1..3
  examRelevance    Int @default(3) // 1..5 NEET-PG yield
  clinicalRelevance Int @default(3) // 1..5
  edgesOut    ConceptEdge[] @relation("fromEdge")
  edgesIn     ConceptEdge[] @relation("toEdge")
  knowledgeStates KnowledgeState[]
  questions   Question[]
  flashcards  Flashcard[]
  revisionItems RevisionItem[]
}

model ConceptEdge {
  id    String @id
  fromId String
  from  Concept @relation("fromEdge", fields: [fromId], references: [id])
  toId  String
  to    Concept @relation("toEdge", fields: [toId], references: [id])
  // prerequisite_of|related_to|causes|caused_by|treated_by|diagnosed_by|complication_of|differential_of|commonly_tested_with|clinical_application_of|mechanism_of|manifestation_of
  type  String
  label String @default("")
  // ── Knowledge Graph (PRODUCT 08, additive) — data-quality provenance so
  // relationships can be reviewed, corrected and updated over time.
  source   String  @default("curated") // curated | ai-suggested | imported
  verified Boolean @default(true) // false = flagged, awaiting review

  @@index([fromId])
  @@index([toId])
  @@index([type])
}

// ───────────────────────── QUESTIONS ─────────────────────────

model Question {
  id          String  @id
  stem        String
  options     Json // [{id:'a',text}, ...]
  answer      String // option id
  explanation String
  teaching    String  @default("") // one-line takeaway
  subjectCode String
  system      String  @default("")
  topicId     String?
  conceptId   String?
  concept     Concept? @relation(fields: [conceptId], references: [id])
  difficulty  Int     @default(2) // 1..3
  qtype       String  @default("sba") // sba|vignette|assertion|rapid|integrated
  tags        Json    @default("[]")
  // ── Adaptive MCQ Engine (PRODUCT 04, additive) ──
  imageUrl    String? // schematic illustration served with image-based stems
  optionNotes Json?   // { optionId: "why this option is wrong" } curated per-option notes
  attempts    QuestionAttempt[]
  subject     Subject @relation(fields: [subjectCode], references: [code])
  savedBy     SavedQuestion[]
  reports     QuestionReport[]
  mistakes    MistakeRecord[]
}

model QuestionAttempt {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  profileId  String
  profile    StudentProfile @relation(fields: [profileId], references: [id])
  selected   String
  correct    Boolean
  errorType  String? // didnt_know|forgot|misread|confused|calculation|reasoning|changed|time|guess
  timeMs     Int      @default(0)
  confidence Int      @default(3) // 1..5
  createdAt  DateTime @default(now())

  @@index([profileId])
}

// ───────────────────────── KNOWLEDGE STATE ─────────────────────────

model KnowledgeState {
  id           String  @id @default(cuid())
  profileId    String
  profile      StudentProfile @relation(fields: [profileId], references: [id])
  conceptId    String
  concept      Concept @relation(fields: [conceptId], references: [id])
  score        Float   @default(0) // 0..100 mastery indicator (learning analytics, not clinical competence)
  attemptCount Int     @default(0)
  correctCount Int     @default(0)
  lastReviewed DateTime?
  lastCorrect  DateTime?
  stability    Float   @default(1) // memory stability in days
  estRecall    Float   @default(0) // 0..1 estimated recall probability
  status       String  @default("new") // new|weak|unstable|strong
  priority     Int     @default(0)

  @@unique([profileId, conceptId])
  @@index([profileId])
}

// ───────────────────────── FLASHCARDS / REVISION ─────────────────────────

model Flashcard {
  id          String  @id
  conceptId   String?
  concept     Concept? @relation(fields: [conceptId], references: [id])
  front       String
  back        String
  subjectCode String
  system      String  @default("")
  tags        Json    @default("[]")
  reviews     FlashcardReview[]
  subject     Subject @relation(fields: [subjectCode], references: [code])
}

model FlashcardReview {
  id           String   @id @default(cuid())
  flashcardId  String
  flashcard    Flashcard @relation(fields: [flashcardId], references: [id])
  profileId    String
  profile      StudentProfile @relation(fields: [profileId], references: [id])
  dueAt        DateTime @default(now())
  intervalDays Float    @default(0)
  reps         Int      @default(0)
  lapses       Int      @default(0)
  lastGrade    Int      @default(2)
  reviewedAt   DateTime?

  @@unique([flashcardId, profileId])
  @@index([profileId])
}

model RevisionItem {
  id         String   @id @default(cuid())
  profileId  String
  profile    StudentProfile @relation(fields: [profileId], references: [id])
  conceptId  String
  concept    Concept  @relation(fields: [conceptId], references: [id])
  reason     String
  priority   Int      @default(2)
  dueAt      DateTime @default(now())
  cleared    Boolean  @default(false)
  clearedAt  DateTime?
  minutes    Int      @default(15)

  @@index([profileId])
}

// ── Smart Revision Engine (PRODUCT 06, additive) ──
// A generated queue snapshot. The plan stores block ids + reasons only;
// content is re-hydrated server-side on resume so answers never live in
// the stored JSON.
model RevisionSession {
  id          String   @id @default(cuid())
  profileId   String
  profile     StudentProfile @relation(fields: [profileId], references: [id])
  mode        String   // daily|rapid|weak|mistake|pyq|flashcard|high-yield|custom
  config      Json // {minutes, subjects?, kinds?} — always written on create
  plan        Json // RevisionBlock[] snapshot (ids + reasons, no answers) — always written on create
  total       Int      @default(0)
  done        Int      @default(0)
  minutes     Int      @default(15)
  status      String   @default("active") // active|completed
  createdAt   DateTime @default(now())
  completedAt DateTime?

  @@index([profileId])
}

model StudySession {
  id        String   @id @default(cuid())
  profileId String
  profile   StudentProfile @relation(fields: [profileId], references: [id])
  minutes   Int
  kind      String // study|questions|revision|case|recall
  label     String   @default("")
  date      DateTime @default(now())

  @@index([profileId])
}

// ───────────────────────── ERRORS / CONFUSIONS ─────────────────────────

model ErrorPattern {
  id        String   @id @default(cuid())
  profileId String
  profile   StudentProfile @relation(fields: [profileId], references: [id])
  errorType String
  conceptId String?
  count     Int      @default(1)
  lastAt    DateTime @default(now())

  @@unique([profileId, errorType, conceptId])
}

model ConfusionPair {
  id        String @id
  a         String
  b         String
  aCode     String @default("") // concept id if exists
  bCode     String @default("")
  aPoints   Json // ["..."]
  bPoints   Json
  mnemonic  String @default("")
  subjectCode String
  system    String @default("")
}

// ───────────────────────── CLINICAL CASES ─────────────────────────

model ClinicalCase {
  id         String @id
  title      String
  specialty  String
  system     String
  difficulty Int    @default(2)
  patient    Json // {age, sex, occupation, complaint}
  steps      Json // [{id, phase, title, content[], question?, options?, answerId?}]
  learning   Json // string[] teaching points
  diagnosis  String @default("")
  runs       CaseRun[]
}

model CaseRun {
  id        String   @id @default(cuid())
  profileId String
  profile   StudentProfile @relation(fields: [profileId], references: [id])
  caseId    String
  case      ClinicalCase @relation(fields: [caseId], references: [id])
  score     Int      @default(0)
  correctSteps Int   @default(0)
  totalSteps Int     @default(0)
  detail    Json?
  completedAt DateTime @default(now())
}

// ───────────────────────── RESOURCES / LOGBOOK ─────────────────────────

model ResourceLog {
  id        String   @id @default(cuid())
  profileId String
  profile   StudentProfile @relation(fields: [profileId], references: [id])
  resource  String // Marrow|PW|PrepLadder|DAMS|Cerebellum|other
  item      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ───────────────────────── RESEARCH HUB (Knowledge OS) ─────────────────────────
// Metadata layer only — we never reproduce full copyrighted papers. Every
// record stores its provenance (`source`) and links back to the original.

model SavedPaper {
  id         String         @id @default(cuid())
  profileId  String
  profile    StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  pmid       String // Europe PMC external id (source-scoped unique key)
  doi        String?
  title      String
  journal    String   @default("")
  pubYear    String   @default("")
  authors    String   @default("")
  abstract   String   @default("")
  url        String   @default("")
  source     String   @default("EUROPE_PMC") // metadata provenance
  tags       Json     @default("[]")
  note       String   @default("")
  createdAt  DateTime @default(now())

  @@unique([profileId, pmid])
  @@index([profileId])
}

model LogbookEntry {
  id        String   @id @default(cuid())
  profileId String
  caseType  String
  system    String
  diagnosis String
  learned   String   @default("")
  createdAt DateTime @default(now())
}

// ───────────────────── GLOBAL LEARNING ENGINE ─────────────────────
// Additive layer (Task 19-h). New models are intentionally STANDALONE —
// no FK relations to Concept/Subject — so db:push stays non-destructive
// and cross-references happen app-side via id arrays stored in Json.

model ResearchPaper {
  id            String  @id
  title         String
  authors       String  @default("")
  year          Int
  journal       String  @default("")
  doi           String?
  url           String?
  field         String  @default("ai-in-medicine")
  evidenceLevel String  @default("landmark-study")
  explainerJson Json // full PaperExplainer

  @@index([field])
}

model CurriculumSource {
  id              String  @id // e.g. "nmc-cbme-2024"
  authority       String
  country         String  @default("")
  scope           String  @default("")
  version         String  @default("")
  sourceUrl       String?
  lastReviewed    String
  alignment       String  @default("concept-aligned") // official-structure|concept-aligned|supplementary
  subjectsCovered Json    @default("[]") // string[] as Json
}

model Asset3D {
  id          String  @id // diagram key
  title       String
  system      String  @default("")
  handcrafted Boolean @default(false)
  dataJson    Json // Asset3DRecord
  conceptIds  Json    @default("[]")
}

model LearningModule {
  id        String   @id
  title     String
  kind      String   @default("pathway") // pathway|course|reasoning-track
  blurb     String   @default("")
  stepsJson Json     @default("[]") // [{conceptId,label,note}] ordered
  createdAt DateTime @default(now())
}

// ───────────────────── AI TUTOR SESSIONS ─────────────────────
// PRODUCT 03 — AI Medical Tutor. Persisted tutoring threads so the tutor is
// a continuing relationship (Ask → Understand → Practice → Feedback → Learn
// again), not a disposable chat. Standalone (no FK relations) like the other
// engine models → db:push stays non-destructive. `topicId` mirrors the Topic
// the session was launched from (context-aware tutoring); messages is the
// serialized [{role, content}] thread.
model TutorSession {
  id        String   @id @default(cuid())
  profileId String
  title     String   @default("New tutoring session")
  mode      String   @default("explain")
  topicId   String   @default("")
  messages  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
}

// ───────────────────── LEARN STUDY PROGRESS ─────────────────────
// Explicit per-entity progress marks from the Learn study surfaces
// (PRODUCT 01 — Medical Learn). Standalone (no FK) like the other
// engine models → db:push stays non-destructive. The 5-state UI
// (Not Started / Learning / Completed / Needs Revision / Mastered)
// resolves as: user mark (this table) ?? auto-derived from
// KnowledgeState analytics — never the other way around.
// ───────────────────── ADAPTIVE MCQ ENGINE (PRODUCT 04) ─────────────────────
// Additive tables for the adaptive practice sessions (measured, deterministic
// engine in src/lib/adaptive.ts — LLM never selects questions). Bookmarks and
// question reports are per-profile so the demo profile owns its own lists.
model AdaptiveSession {
  id          String   @id @default(cuid())
  profileId   String
  profile     StudentProfile @relation(fields: [profileId], references: [id])
  mode        String // AdaptiveMode id
  config      Json // AdaptiveConfig as stored at start
  state       Json // engine state: queue/answered/markedIds/missedConcepts (always written on create)
  total       Int
  answered    Int      @default(0)
  correct     Int      @default(0)
  report      Json? // AdaptiveReport snapshot after completion
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([profileId])
}

model SavedQuestion {
  id         String   @id @default(cuid())
  profileId  String
  profile    StudentProfile @relation(fields: [profileId], references: [id])
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([profileId, questionId])
}

model QuestionReport {
  id         String   @id @default(cuid())
  profileId  String
  profile    StudentProfile @relation(fields: [profileId], references: [id])
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  reason     String
  detail     String   @default("")
  createdAt  DateTime @default(now())
}

model LearnProgress {
  id        String   @id @default(cuid())
  profileId String
  kind      String // 'topic' | 'concept'
  entityId  String // Topic.id or Concept.id
  status    String // 'learning' | 'completed' | 'needs-revision' | 'mastered'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, kind, entityId])
  @@index([profileId])
}

// ───────────────────── MISTAKE INTELLIGENCE (PRODUCT 05) ─────────────────────
// One aggregate row per (profile, question) the student has ever answered
// wrong. The attempt feed (QuestionAttempt) stays the event log; this table is
// the MISTAKE BANK: lifecycle status + repetition + review bookkeeping. Rows
// are synced from attempts by lib/mistake-intel.ts (ensureMistakeRecords) and
// written on the fly by recordAttempt for every source that answers MCQs
// (practice, mocks, PYQ, image, adaptive, tutor quizzes).
model MistakeRecord {
  id             String   @id @default(cuid())
  profileId      String
  profile        StudentProfile @relation(fields: [profileId], references: [id])
  questionId     String
  question       Question @relation(fields: [questionId], references: [id])
  conceptId      String?
  wrongCount     Int      @default(1)
  firstWrongAt   DateTime @default(now())
  lastWrongAt    DateTime @default(now())
  lastSelected   String   @default("") // option id of the latest wrong pick
  lastErrorType  String?  // latest self-reported tag, if any
  // lifecycle: unresolved → revising (revision item open) → retested (one
  // correct retest) → resolved (two consecutive correct retests, or manual)
  status         String   @default("unresolved")
  retestCount    Int      @default(0) // retests attempted
  retestCorrect  Int      @default(0) // consecutive correct retests (0..2)
  resolvedAt     DateTime?
  resolvedBy     String?  // 'retest' | 'manual'
  lastReviewedAt DateTime? // last time the student opened this mistake
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([profileId, questionId])
  @@index([profileId, status])
  @@index([profileId, lastWrongAt])
}

// ───────────────────── CLINICAL CASE SIMULATOR (PRODUCT 09) ─────────────────────
// First-class case simulator beside the legacy ClinicalCase/CaseRun pair
// (both preserved untouched — legacy routes/views keep working). STANDALONE
// engine model: profileId is a plain string (no FK), like Planner*/Graph* —
// db:push stays non-destructive.
//
// SimCase        — the case + its HIDDEN answer key (brief). The brief never
//                  leaves the server: /api/sim/cases/[id] strips verdicts,
//                  whys, findings and keys before responding.
// SimCaseAttempt — one student run (guided or AI mode). `events` is the
//                  append-only interaction log [ {stageId, interactionId,
//                  chosen[], correct, score, ts, chat?} ] so an attempt can
//                  always be resumed and every score is MEASURED, not
//                  client-reported.
model SimCase {
  id              String   @id
  title           String
  specialty       String // Medicine | Surgery | Paediatrics | Obstetrics & Gynaecology | Psychiatry | Dermatology | Ophthalmology | ENT | Orthopaedics | Radiology | Pathology | Emergency Medicine | Cardiology
  system          String   @default("")
  difficulty      String   @default("mbbs") // beginner | mbbs | neetpg | advanced
  patient         Json // {age, sex, occupation, complaint, scene}
  brief           Json // answer key: stages/interactions/verdicts/findings/learning/conceptIds/aiBrief
  estimateMinutes Int      @default(12)
  imageKey        String? // key into the platform-owned clinical image set (public/questions/*)
  imageCaption    String   @default("")
  aiReady         Boolean  @default(false) // AI Case Mode available (curated aiBrief in brief)
  source          String   @default("curated") // curated | imported-legacy
  attempts        SimCaseAttempt[]
  createdAt       DateTime @default(now())

  @@index([specialty])
}

model SimCaseAttempt {
  id               String    @id @default(cuid())
  profileId        String
  caseId           String
  case             SimCase   @relation(fields: [caseId], references: [id])
  status           String    @default("active") // active | completed | abandoned
  mode             String    @default("guided") // guided | ai
  stageIndex       Int       @default(0)
  events           Json      @default("[]") // append-only interaction + chat log
  score            Int       @default(0)
  diagnosisCorrect Boolean   @default(false)
  reasoning        Int       @default(0)
  investigations   Int       @default(0)
  management       Int       @default(0)
  timeMs           Int       @default(0)
  startedAt        DateTime  @default(now())
  completedAt      DateTime?

  @@index([profileId, status])
  @@index([caseId])
}

// ──────────────── MEDICAL IMAGE LEARNING LAB (PRODUCT 10) ────────────────
// Additive tables for the interactive image-interpretation lab. STANDALONE
// engine model: profileId is a plain string (no FK) — db:push stays
// non-destructive, existing tables untouched.
//
// LabImage    — one teaching image + its HIDDEN answer key (brief). The brief
//               (identify answers, finding regions + verdicts, quiz answers,
//               guided whys, aiBrief) never leaves the server raw — routes
//               strip it to {id,label} projections. Region convention:
//               x/y in % of the natural image, r = hit radius in % of height;
//               the ENGINE grades pins (server-side, no client trust).
// LabAttempt  — one student run in one of the six modes. `answers` is the
//               append-only log [ {type:'answer', stepId, chosen?, pin?,
//               correct, score, timeMs, ts} ] so scores are MEASURED and any
//               graded attempt can be audited.
model LabImage {
  id            String   @id
  title         String
  diagnosis     String   @default("") // the answer, shown in library/organisation contexts
  modality      String // X-ray | CT | MRI | ECG | Histology | Pathology | Dermatology | Ophthalmology | Anatomy | Microbiology | Ultrasound | Clinical
  system        String   @default("")
  subjectCode   String
  conceptIds    Json     @default("[]") // verified concept links for hand-offs
  src           String // /questions/<file> — platform-owned asset set
  provenance    String   @default("ai-illustration") // owned-clinical | ai-illustration
  sourceNote    String   @default("") // provenance/reference line shown in the UI
  difficulty    Int      @default(2) // 1..3 (mirrors Question.difficulty)
  examRelevance Int      @default(3) // 1..5 NEET-PG/MBBS yield rating
  isNormal      Boolean  @default(false) // normal reference image (compare mode anchor)
  compareGroup  String?  // groups normal-vs-abnormal / similar-conditions sets
  brief         Json // HIDDEN answer key (LabBrief) — server-side only
  aiReady       Boolean  @default(true)
  attempts      LabAttempt[]
  createdAt     DateTime @default(now())

  @@index([modality])
  @@index([subjectCode])
  @@index([compareGroup])
}

model LabAttempt {
  id            String    @id @default(cuid())
  profileId     String
  imageId       String
  image         LabImage  @relation(fields: [imageId], references: [id])
  mode          String    @default("identify") // identify | interpret | diagnose | quiz | guided | rapid
  status        String    @default("active") // active | completed | abandoned
  stepIndex     Int       @default(0)
  answers       Json      @default("[]") // append-only graded answer log
  correct       Boolean   @default(false)
  score         Int       @default(0)
  findingsHit   Int       @default(0)
  findingsTotal Int       @default(0)
  timeMs        Int       @default(0)
  startedAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([profileId, status])
  @@index([imageId])
}

// ───────────────────── AI STUDY PLANNER (PRODUCT 07) ─────────────────────
// Additive tables for the personalized study planner. STANDALONE (no FK
// relations) like the other engine models → db:push stays non-destructive.
//
// PlannerPlan  — the durable plan SHAPE: settings (exam date, capacity,
//                off-days), phase windows, weekly goals, last feasibility
//                check. The DAY schedule is never stored stale — today's
//                queue is always regenerated from live signals.
// PlannerDayLog — one row per (profile, IST day): chosen mode + planned vs
//                done totals. The consistency / adherence feed.
// PlannerTask  — task instances for a given day with lifecycle (pending →
//                done | skipped; stale pending → missed on next generation).
//                Completed tasks are durable; pending ones are regenerated.
model PlannerPlan {
  id             String    @id @default(cuid())
  profileId      String
  status         String    @default("active") // active | archived
  examDate       DateTime?
  examLabel      String    @default("")
  targetNote     String    @default("") // honest pacing anchor — never a rank promise
  dailyMinutes   Int       @default(240)
  weekdayMinutes Int       @default(0) // 0 → fall back to dailyMinutes
  weekendMinutes Int       @default(0) // 0 → fall back to dailyMinutes
  offDays        Json      @default("[]") // IST weekday keys, e.g. ["Sun"]
  plan           Json      // PlannerPlanShape snapshot (phases, weekly goals, notes)
  feasibility    Json      // last computed feasibility verdict
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([profileId, status])
}

model PlannerDayLog {
  id             String   @id @default(cuid())
  profileId      String
  dayKey         String   // IST calendar day 'YYYY-MM-DD'
  mode           String   @default("auto") // auto|full|two-hour|one-hour|revision|mock|catch-up|last-30|emergency
  plannedMinutes Int      @default(0)
  doneMinutes    Int      @default(0)
  plannedCount   Int      @default(0)
  doneCount      Int      @default(0)
  status         String   @default("open") // open | partial | done | rest
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([profileId, dayKey])
  @@index([profileId, dayKey])
}

// ───────────────────── MEDICAL KNOWLEDGE GRAPH (PRODUCT 08) ─────────────────
// Additive, STANDALONE tables (no FK relations) → db:push stays non-destructive.
//
// GraphSynonym — natural medical terminology variants ("HF", "heart attack",
//                "IHD") resolved to canonical concepts during search so a
//                student's own words find the right hub.
// GraphFeedback — students flag a relationship as wrong/helpful. Feedback is
//                reviewed and edges corrected; wrong-flagged edges are marked
//                ConceptEdge.verified=false until fixed.
model GraphSynonym {
  id     String @id
  term   String @unique // lowercase natural term, e.g. "hf", "heart attack"
  kind   String // concept | topic | subject
  refId  String // canonical Concept.id / Topic.id / Subject.id
  weight Int    @default(1) // ranking boost for exact abbreviations

  @@index([refId])
}

model GraphFeedback {
  id        String   @id @default(cuid())
  profileId String
  fromId    String
  toId      String
  type      String
  vote      String // wrong | helpful | unsure
  note      String   @default("")
  status    String   @default("open") // open | reviewed | fixed
  createdAt DateTime @default(now())

  @@index([profileId])
  @@index([status])
}

model PlannerTask {
  id        String    @id @default(cuid())
  profileId String
  dayKey    String    // IST calendar day this task belongs to
  slot      String    // study | practice | revise | test
  kind      String    // topic-learn | concept-repair | mcq | mistake-retest | revision-session | flashcards | mock | pyq | case | catch-up
  refId     String    @default("") // topicId / conceptId / pairId / …
  title     String
  detail    String    @default("") // actionable one-liner
  reason    String    @default("") // measured why-this note (never chain-of-thought)
  minutes   Int       @default(20)
  priority  Int       @default(50) // 0..100
  status    String    @default("pending") // pending | done | skipped | missed
  doneAt    DateTime?
  meta      Json? // hand-off payload (adaptive preset, revision start config…)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([profileId, dayKey, slot, kind, refId])
  @@index([profileId, dayKey])
}

// ──────────────── MEDICAL VOICE TUTOR (PRODUCT 11) ────────────────
// Additive table for hands-free conversational learning. STANDALONE engine
// model: profileId is a plain string (no FK) — db:push stays non-destructive,
// existing tables untouched (same pattern as SimCaseAttempt / LabAttempt).
//
// VoiceSession — one spoken learning session. The transcript is an
//               append-only log ({role:'tutor'|'student', text, at}) and
//               evals logs structured spoken-answer verdicts
//               ({concept, verdict:'correct'|'partial'|'missed', note, at})
//               parsed from the tutor's fenced blocks — the raw block never
//               reaches the client. Counters (questions/correct) drive the
//               debrief and the platform-wide feeds.
model VoiceSession {
  id          String    @id @default(cuid())
  profileId   String
  mode        String // listen | rapid | viva | revision | clinical | doubt
  topicId     String    @default("")
  topicLabel  String    @default("")
  status      String    @default("active") // active | completed | abandoned
  transcript  Json      @default("[]") // append-only spoken transcript
  evals       Json      @default("[]") // append-only graded-answer verdicts
  questions   Int       @default(0) // graded spoken answers so far
  correct     Int       @default(0) // verdict === 'correct'
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([profileId, status])
  @@index([profileId, startedAt])
}

// ──────────────── EXAM SIMULATOR & MOCK TEST LAB (PRODUCT 12) ────────────────
// Additive table for realistic NEET-PG-style testing. STANDALONE engine model:
// profileId is a plain string (no FK) — db:push stays non-destructive, existing
// tables untouched (same pattern as SimCaseAttempt / LabAttempt / VoiceSession).
//
// ExamAttempt — one exam paper. `questionIds` is the frozen ordered paper.
//               `responses` is the live answer sheet keyed by questionId:
//               {questionId, history:[option ids in pick order — last = current],
//                timeMs (accumulated), marked (review flag), at}. Answer changes
//               are recorded (history), never punished by the engine — they are
//               measured as careless-mistake signals in the analysis.
//               `events` is the append-only exam log ({kind, questionId?, at}).
// Grading is DETERMINISTIC server-side at submit (+4 correct / −1 wrong /
// 0 unattempted when negative marking is on) — answers never leave the server
// before submit, and no AI is involved anywhere in selection or scoring.
model ExamAttempt {
  id            String    @id @default(cuid())
  profileId     String
  mode          String // full | subject | topic | pyq | custom | weak | adaptive | image | rapid
  label         String    @default("")
  config        Json // frozen config at start (subjects/topics/difficulty/count/minutes/negativeMark/sources)
  questionIds   Json      @default("[]") // ordered paper — string[]
  responses     Json      @default("[]") // live answer sheet (see header comment)
  events        Json      @default("[]") // append-only exam event log
  status        String    @default("active") // active | submitted | abandoned
  total         Int       @default(0)
  answered      Int       @default(0)
  correct       Int       @default(0)
  wrong         Int       @default(0)
  unattempted   Int       @default(0)
  score         Int       @default(0)
  maxScore      Int       @default(0)
  timeMs        Int       @default(0) // wall time start → submit
  autoSubmitted Boolean   @default(false)
  report        Json? // ExamAnalysis snapshot after submit
  startedAt     DateTime  @default(now())
  submittedAt   DateTime?

  @@index([profileId, status])
  @@index([profileId, startedAt])
}

// ───────────────── MEDICAL CONTENT & RESOURCE HUB (PRODUCT 14) ─────────────────
// Saved bookmarks + quality-control reports over the curated resource catalog.
// Standalone (no FK relations) like the other engine models → db:push stays
// non-destructive. resourceId is a catalog id ('ext:…' | 'platform:…') — the
// catalog itself is code-versioned (src/lib/resource-catalog.ts + measured
// platform synthesis), so no resource table is needed and nothing copyrighted
// is ever stored locally: metadata + ids only.

model SavedResource {
  id         String   @id @default(cuid())
  profileId  String
  resourceId String
  note       String   @default("")
  createdAt  DateTime @default(now())

  @@unique([profileId, resourceId])
  @@index([profileId])
}

model ResourceReport {
  id         String   @id @default(cuid())
  profileId  String
  resourceId String
  reason     String // incorrect|broken|outdated|copyright|other
  details    String   @default("")
  status     String   @default("open") // open|reviewed|resolved
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([profileId, resourceId])
  @@index([status])
}

// ─── PRODUCT 15 — AI MEDICAL SEARCH & ANSWER ENGINE ─────────────────────────
// One thread per natural-language ask («Why does nephrotic syndrome cause
// edema?», «Explain AKI», «X vs Y»). The engine (src/lib/ask-engine.ts) ALWAYS
// re-derives retrieval + grounding live from the platform (concepts, lessons,
// graph edges, questions, cases, resources, this student's knowledge states);
// `grounding` merely snapshots the deterministic knowledge-page payload so a
// thread can be re-opened later without re-computing. Standalone (no FK) like
// the other engine models → db:push stays non-destructive. Personal messages
// are capped server-side; nothing here is medical advice.
model AskThread {
  id                 String   @id @default(cuid())
  profileId          String
  title              String   @default("") // short thread label (root query, trimmed)
  rootQuery          String   @default("") // verbatim first query
  resolvedKind       String   @default("none") // concept|topic|compare|none
  conceptId          String   @default("") // primary resolved concept ('' when none)
  secondaryConceptId String   @default("") // compare target ('' when none)
  level              String   @default("mbbs") // eli5|mbbs|neetpg|detailed
  grounding          Json?    // snapshot of the AskAnswerPayload (minus threadId)
  messages           Json     @default("[]") // follow-up transcript [{role,kind,text,payload?}]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([profileId, updatedAt])
}

// ─── PRODUCT 16 — MEDICAL LEARNING COMMUNITY & ACCOUNTABILITY ───────────────
// Focused, moderated learning community (NOT a social network). All tables are
// STANDALONE (no FK relations) like the other engine models → db:push stays
// non-destructive. Identity model: "you" is the single demo StudentProfile;
// every other member is a SEEDED DEMO PEER (CommunityMember.seeded, labelled in
// the UI). Accountability numbers are always MEASURED from real study activity
// — nothing here invents progress. Patient-identifying content is blocked by
// deterministic scans at write time (src/lib/community-engine.ts).

// Structured spaces: exam hubs (NEET-PG/FMGE), subject-wise (from the registry),
// doubt clearance, PYQ discussions, case discussions, revision circle.
// Topic-wise discussions live inside these spaces as topic-tagged posts.
model CommunitySpace {
  id          String   @id // stable seed id 'c-space-…'
  kind        String // exam|subject|doubt|pyq|case|revision
  name        String
  description String   @default("")
  subjectCode String   @default("") // subject spaces
  rules       Json     @default("[]") // string[] space rules
  createdAt   DateTime @default(now())

  @@index([kind])
}

// Seeded demo peers. The real user is never stored here — 'you' is derived
// from the signed-in StudentProfile at read time.
model CommunityMember {
  id        String   @id @default(cuid())
  handle    String   @unique // 'aarav-s'
  name      String
  year      Int      @default(3)
  bio       String   @default("")
  seeded    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// One discussion thread. groupId optionally scopes it to a study group
// (group discussions are posts too — one table, one moderation path).
// authorProfileId is '' for seeded peer posts; authorMemberId is '' for 'you'.
model CommunityPost {
  id              String   @id @default(cuid())
  profileId       String   @default("") // author profile id ('' = seeded peer)
  authorMemberId  String   @default("") // seeded peer author ('' = you)
  spaceId         String
  groupId         String   @default("") // '' = regular space post
  kind            String // question|discussion|pyq|mcq|case
  title           String
  body            String
  tags            Json     @default("[]") // string[]
  subjectCode     String   @default("")
  topicId         String   @default("")
  questionRef     String   @default("") // platform Question id for MCQ/PYQ threads
  upvotes         Int      @default(0)
  views           Int      @default(0)
  replyCount      Int      @default(0)
  resolved        Boolean  @default(false)
  answeredReplyId String   @default("")
  status          String   @default("open") // open|review|removed
  flagged         String   @default("") // ''|spam|abuse — review-hold reason
  removedReason   String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([spaceId, status])
  @@index([groupId, status])
  @@index([profileId])
  @@index([authorMemberId])
}

model CommunityReply {
  id             String   @id @default(cuid())
  postId         String
  profileId      String   @default("") // '' = seeded peer
  authorMemberId String   @default("") // '' = you
  body           String
  upvotes        Int      @default(0)
  isAnswer       Boolean  @default(false) // marked by the asker
  aiAssisted     Boolean  @default(false) // drafted with AI help — labelled
  status         String   @default("open") // open|review|removed
  createdAt      DateTime @default(now())

  @@index([postId, status])
  @@index([profileId])
  @@index([authorMemberId])
}

// "You" upvotes only (toggle). Peer upvotes are pre-seeded into the counters.
model CommunityVote {
  id         String   @id @default(cuid())
  profileId  String
  targetType String // post|reply
  targetId   String
  createdAt  DateTime @default(now())

  @@unique([profileId, targetType, targetId])
}

model SavedDiscussion {
  id        String   @id @default(cuid())
  profileId String
  postId    String
  createdAt DateTime @default(now())

  @@unique([profileId, postId])
}

// Moderation queue: spam | abuse | misinformation | privacy | other.
model CommunityReport {
  id         String   @id @default(cuid())
  profileId  String
  targetType String // post|reply|member
  targetId   String
  reason     String
  details    String   @default("")
  status     String   @default("open") // open|reviewed|actioned
  createdAt  DateTime @default(now())

  @@index([status])
  @@index([profileId])
}

// Block / mute a peer. Blocking hides their content everywhere for you.
model MemberBlock {
  id        String   @id @default(cuid())
  profileId String
  memberId  String
  kind      String // block|mute
  createdAt DateTime @default(now())

  @@unique([profileId, memberId, kind])
}

// Study groups — public or private, subject/topic/exam focused.
model StudyGroup {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  description    String   @default("")
  privacy        String   @default("public") // public|private
  focusKind      String   @default("mixed") // subject|topic|exam|mixed
  focusRef       String   @default("") // subjectCode / topicId / exam label
  goalText       String   @default("")
  meetCadence    String   @default("")
  plan           Json     @default("[]") // shared study plan [{id,line,addedBy,at}] capped 20
  ownerProfileId String   @default("") // '' = seeded owner (ownerMemberId)
  ownerMemberId  String   @default("")
  seeded         Boolean  @default(true)
  status         String   @default("open") // open|archived
  createdAt      DateTime @default(now())
}

// One row per member. actorKey is 'you' for the signed-in student or the
// CommunityMember id for peers (unique per group). shareData is the EXPLICIT
// per-group privacy opt-in for sharing personal progress (default false).
model GroupMembership {
  id        String   @id @default(cuid())
  groupId   String
  actorKey  String // 'you' | CommunityMember id
  profileId String   @default("")
  role      String   @default("member") // owner|member
  shareData Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([groupId, actorKey])
}

// Group accountability: MCQ / mock / revision / case challenges.
// Peer progress lines are a SEEDED SNAPSHOT in progress json — your line is
// always measured live from real activity since the challenge started.
model GroupChallenge {
  id        String    @id @default(cuid())
  groupId   String
  kind      String // mcq|mock|revision|case
  title     String
  detail    String    @default("")
  target    Int       @default(0)
  unit      String    @default("mcqs") // mcqs|mocks|sessions|cases
  dueAt     DateTime?
  status    String    @default("active") // active|complete|archived
  progress  Json      @default("[]") // [{actorKey,label,count,at}] — seed snapshot
  seeded    Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@index([groupId, status])
}

// Personal accountability goals (IST-day windows like PlannerTask).
// scope: daily | weekly | commitment. Progress is ALWAYS measured from real
// activity tables — never self-reported counters.
model AccountabilityGoal {
  id        String    @id @default(cuid())
  profileId String
  scope     String // daily|weekly|commitment
  kind      String // mcqs|study|revision|mock|case|custom
  title     String    @default("")
  target    Int
  unit      String    @default("mcqs") // mcqs|minutes|sessions|mocks|cases
  dueAt     DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([profileId, scope])
}

// Per-profile community settings (guidelines acceptance + AI assist toggle).
model CommunitySettings {
  profileId           String    @id
  guidelinesAccepted  Boolean   @default(false)
  acceptedAt          DateTime?
  aiAssist            Boolean   @default(true)
  updatedAt           DateTime  @updatedAt
}

// ═════════════ GAMIFIED MEDICAL LEARNING & MOTIVATION ENGINE (PRODUCT 17) ═════════════
// Additive, STANDALONE models (no FK, plain string profileId) — db:push stays
// non-destructive (same pattern as SimCaseAttempt / VoiceSession / Community).
//
// Honesty rules: XP is materialized ONLY from measured study activity
// (QuestionAttempt / StudySession / RevisionSession / submitted ExamAttempt /
// SimCaseAttempt / FlashcardReview / KnowledgeState mastery / resolved
// MistakeRecord). Opening the app earns nothing. Achievements are code-
// versioned definitions evaluated against measurement; ChallengeEnrollment
// stores the measured baseline snapshot for adaptive targets. Leaderboards
// reuse the P16 per-group shareData consent — no new sharing surface.

// One measured learning action that earned XP. Unique on
// (profileId, kind, refId) makes every grant idempotent — re-syncing never
// double-counts. refId is the source row id (attempt id / session id /
// exam id / case id / topicId / mistakeId / `${cardId}:${dayKey}` /
// enrollment id; '' only for the per-day study cap rows).
model XpEvent {
  id        String   @id @default(cuid())
  profileId String
  kind      String // mcq-correct|mcq-repeat-correct|mcq-attempt|revision|flashcards|study|mock|case|topic-mastered|mistake-corrected|challenge-completed
  refId     String   @default("")
  dayKey    String // IST day key the activity belongs to
  xp        Int
  meta      Json? // measured snapshot ({subjectCode, correct, accuracy} …) kept small
  createdAt DateTime @default(now())

  @@unique([profileId, kind, refId])
  @@index([profileId, dayKey])
  @@index([profileId, createdAt])
}

// Unlock record for a code-versioned achievement definition. Evaluated
// deterministically from measurement on every engine sync; the unique
// constraint makes evaluation idempotent.
model AchievementUnlock {
  id            String   @id @default(cuid())
  profileId     String
  achievementId String // definition id in gamify-engine (e.g. 'mcq-100')
  meta          Json? // measured snapshot at unlock time
  earnedAt      DateTime @default(now())

  @@unique([profileId, achievementId])
  @@index([profileId])
}

// One enrollment on a code-versioned challenge definition. startSnap freezes
// the measured baseline (volume/accuracy/weak topics) the adaptive target was
// computed from; progress is ALWAYS re-measured live from real activity.
model ChallengeEnrollment {
  id           String    @id @default(cuid())
  profileId    String
  challengeId  String // definition id in gamify-engine (e.g. 'mcq-100-challenge')
  status       String    @default("active") // active | completed | abandoned
  startSnap    Json? // measured baseline at enrollment
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  bonusXpEvent String    @default("") // XpEvent id for the one-time completion bonus

  @@unique([profileId, challengeId])
  @@index([profileId, status])
}

// Per-profile motivation preferences. featured = up to 3 achievement ids
// showcased in the Motivation header. No new sharing surface lives here —
// leaderboard sharing reuses GroupMembership.shareData (P16 consent).
model MotivationSettings {
  profileId String   @id
  featured  Json     @default("[]") // string[] of achievement ids, capped 3
  updatedAt DateTime @updatedAt
}

// ═════════════ PERSONAL MEDICAL BRAIN (PRODUCT 18) ═════════════
// Additive, STANDALONE models (no FK, plain string profileId) — db:push stays
// non-destructive (P11–P17 pattern).
//
// Privacy rules: the brain is PRIVATE BY DEFAULT — no sharing surface exists
// and nothing here is exposed to other students. BrainSettings holds the
// per-surface personalization switches (AI Tutor context, question feed,
// revision feed, content feed) and the history-snapshot opt-in. Every value
// the brain derives stays computed-on-read from measured activity; the only
// persisted artifacts are the daily snapshot (for the longitudinal timeline)
// and the settings row. Data control routes: export (view stored data) and
// scoped reset (delete learning history) live in /api/brain/*.

// Per-profile brain personalization + privacy controls. All personalization
// defaults ON (the brain personalizes the student's own experience only);
// disabling a switch makes that surface fall back to non-personalized
// behavior. tutorContextOn gates what the AI Tutor is told about the student
// (transparency view: /api/brain/tutor-context shows the exact blocks).
model BrainSettings {
  profileId                 String   @id
  personalizationOn         Boolean  @default(true)
  tutorContextOn            Boolean  @default(true)
  questionPersonalizationOn Boolean  @default(true)
  revisionPersonalizationOn Boolean  @default(true)
  contentPersonalizationOn  Boolean  @default(true)
  historySnapshotsOn        Boolean  @default(true)
  updatedAt                 DateTime @updatedAt
}

// One daily materialized snapshot of the derived profile (IST day key),
// used ONLY for the longitudinal timeline ("mastery over time"). Unique on
// (profileId, dayKey) makes materialization idempotent. data is a small
// capped object {conceptsByState, accuracy, counts…} — no raw content.
// Respect for privacy: snapshots stop the moment historySnapshotsOn=false;
// deleting snapshots (reset scope 'snapshots') erases the timeline history.
model BrainSnapshot {
  id        String   @id @default(cuid())
  profileId String
  dayKey    String // IST day key
  data      Json // capped derived counters ({mastered, strong, atRisk, needsRevision, accuracy, conceptsByState})
  createdAt DateTime @default(now())

  @@unique([profileId, dayKey])
  @@index([profileId, createdAt])
}
